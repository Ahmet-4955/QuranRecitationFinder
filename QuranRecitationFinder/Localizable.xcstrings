    "Maximum length": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstdauer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Azami süre"
          }
        }
      }
    },
    "Maximum length: the recording ends after this time at the latest; 8–15 seconds are usually enough. Silence: stops after 2.5 s of quiet, breathing pauses are tolerated. Early recognition: once the verse is clearly recognized twice in a row, the recording ends immediately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstdauer: Die Aufnahme endet spätestens nach dieser Zeit, 8–15 Sekunden reichen meist. Stille: Stopp nach 2,5 s Ruhe, Atempausen werden toleriert. Früherkennung: Ist der Vers zweimal hintereinander eindeutig erkannt, endet die Aufnahme sofort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Azami süre: Kayıt en geç bu sürenin sonunda biter; genellikle 8–15 saniye yeterlidir. Sessizlik: 2,5 sn sessizlikten sonra durur, nefes araları tolere edilir. Erken tanıma: Ayet arka arkaya iki kez net olarak tanınırsa kayıt hemen biter."
          }
        }
      }
    },
