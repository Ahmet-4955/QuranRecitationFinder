    "Every recognition is saved with your rating – only on this device. Export via AirDrop to the Mac, then Tools/phase5/calibrate.py.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Erkennung wird mit Ihrer Bewertung gespeichert – nur auf diesem Gerät. Export per AirDrop an den Mac, dann Tools/phase5/calibrate.py."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tanıma, değerlendirmenizle birlikte kaydedilir – yalnızca bu cihazda. AirDrop ile Mac'e aktarın, ardından Tools/phase5/calibrate.py."
          }
        }
      }
    },
